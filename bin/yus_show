#!/usr/bin/env ruby

$: << File.expand_path('../lib', File.dirname(__FILE__))

require 'drb'
require 'drb/ssl'
require 'yus/session'
require 'yus/helpers'

options = Yus.default_opts
options["recursive"] = false
parser = Yus.default_parser(options)
parser.banner = "Usage: yus_show [options] <username>"
parser.on("-R", "--recursive", "Show username recursively") do |value|
  options["recursive"] = value
end


parser.parse!(into: options)
unless (name = ARGV.first)
  puts parser.help
  exit(1)
end

session = Yus.session(options)
puts session.show(name, options["recursive"])
