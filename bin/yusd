#!/usr/bin/env ruby
$: << File.expand_path('../lib', File.dirname(__FILE__))
require 'yaml'
require 'logger'
require 'drb'
require 'drb/ssl'
require 'drb/timeridconv'
require 'digest/sha2'
require 'yus/helpers'

default_options = Yus.default_opts
default_options[:ssl_key] = File.expand_path('../data/yus.key', File.dirname(__FILE__))
default_options[:ssl_cert] = File.expand_path('../data/yus.crt', File.dirname(__FILE__))
default_options[:cleaner_interval] = 300
default_options[:session_timeout] = 3600
default_options[:persistence] = "odba"
default_options[:db_auth] = "yus"
default_options[:db_user] = "yus"
default_options[:db_name] = "yus"
default_options[:digest] = Digest::SHA256
default_options[:log_file] = "STDERR"
default_options[:log_level] = "INFO"
default_options[:root_name] = "admin"
default_options[:root_pass] = nil

parser = Yus.default_parser(default_options)
parser.banner = "To start your YUS daemon call: yusd [options]"
parser.on("--token_lifetime seconds", "Lifetime in seconds before a token expires") do |value|
        default_options["token_lifetime"] = value
      end
parser.on("--ssl_cert file", "path of SSL certificate file") do |value|
        default_options["ssl_cert"] = value
      end
options = {}
parser.parse!(into: options)
config = Yus::Config.new(options.merge!(default_options))

require File.join('yus', 'persistence', config.persistence)
persistence = nil
require 'odba/connection_pool'
require 'odba/drbwrapper'
DRb.install_id_conv ODBA::DRbIdConv.new
if /sqlite/i.match(config.db_name)
 ODBA.storage.dbi = ODBA::ConnectionPool.new('sqlite:/')
else
  ODBA.storage.dbi = ODBA::ConnectionPool.new("DBI:Pg:#{config.db_name}",
                                              config.db_user, config.db_auth)
end
ODBA.cache.setup
persistence = Yus::Persistence::Odba.new

log_file = config.log_file
if(log_file.is_a?(String))
	FileUtils.mkdir_p(File.dirname(log_file))
	log_file = File.open(log_file, 'a')
	at_exit { log_file.close }
end
logger = Logger.new(log_file)
logger.level = Logger.const_get(config.log_level)

begin
  server = Yus::Server.new(persistence, config, logger)
  server.extend(DRbUndumped)

  url = config.server_url
  drbconf = {}
  case url
  when /drbssl/
    keypath = File.expand_path(config.ssl_key, config.yus_dir)
    certpath = File.expand_path(config.ssl_cert, config.yus_dir)
    drbconf.update({
      :SSLPrivateKey => OpenSSL::PKey::RSA.new(File.read(keypath)),
      :SSLCertificate => OpenSSL::X509::Certificate.new(File.read(certpath)),
    })
  end
  DRb.start_service(url, server, drbconf)
	logger.info('start') { sprintf("starting yus-server on %s", url) }
  DRb.thread.join
rescue Exception => error
	logger.error('fatal') { error }
	raise
end
