#!/usr/bin/env ruby

$: << File.expand_path('../lib', File.dirname(__FILE__))

require 'drb'
require 'drb/ssl'
require 'yus/session'
require 'yus/helpers'
require 'getoptlong'

opts = Yus.default_opts
parser = Yus.default_parser(opts)
parser.banner = "Usage: yus_delete_user <username>"

parser.parse!(into: opts)
unless (name = ARGV.first)
  puts parser.help
  exit(1)
end

session = Yus.session(opts)
session.delete_entity(name)
puts "Deleted user #{name}"
